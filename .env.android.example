# Copy to .env.android.local and use the same key as previous releases.
ANDROID_KEYSTORE_PATH=/absolute/path/to/release.keystore
ANDROID_KEY_ALIAS=branchloom

# Passwords are requested in the terminal when omitted.
# For unattended builds, provide ANDROID_KEYSTORE_PASSWORD and
# ANDROID_KEY_PASSWORD through the environment.

# Optional overrides; installed SDK/build tools are detected by default.
# ANDROID_SDK_ROOT=/absolute/path/to/Android/sdk
# ANDROID_BUILD_TOOLS_VERSION=36.0.0
