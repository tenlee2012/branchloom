{
  "name": "@branchloom/cli",
  "version": "0.1.1",
  "description": "Native Rust command-line interface for Branchloom genealogy data",
  "type": "module",
  "bin": {
    "branchloom": "bin/branchloom.js"
  },
  "files": [
    "bin",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "cargo build --manifest-path ../../Cargo.toml -p branchloom-cli",
    "build:cli": "cargo build --manifest-path ../../Cargo.toml -p branchloom-cli",
    "build:release": "cargo build --manifest-path ../../Cargo.toml --release -p branchloom-cli",
    "install:local": "node scripts/install-local.mjs",
    "prepack": "npm run build:release && node scripts/stage-native.mjs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "license": "Apache-2.0"
}
